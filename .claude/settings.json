      "Bash(sbt check)",
      "Bash(sbt clean check)",
      "Bash(sbt test)",
      "Bash(sbt compile)",
      "Bash(sbt Test/compile)",
      "Bash(sbt fmt)",
      "Bash(sbt localPipelineDev)",
      "Bash(sbt goldSetEvalDev)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform fmt -recursive -check *)",
      "Bash(terraform validate *)",
      "Bash(.claude/hooks/validate-agent-files.sh)",
      "Bash(./.claude/hooks/validate-agent-files.sh)",
      "Bash(.claude/hooks/validate-agent-files.sh --probes)",
      "Bash(.claude/hooks/verify-tests-ran.sh --check)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(scripts/plan.sh *)",
      "Bash(./scripts/plan.sh *)",
      "Bash(scripts/deploy.sh *)",
      "Bash(./scripts/deploy.sh *)",
      "Bash(scripts/rollback.sh *)",
      "Bash(./scripts/rollback.sh *)",
      "Bash(scripts/run-bounded-pipeline.sh *)",
      "Bash(./scripts/run-bounded-pipeline.sh *)",
      "Bash(scripts/run-experiment.sh *)",
      "Bash(./scripts/run-experiment.sh *)",
      "Bash(scripts/smoke-test.sh *)",
      "Bash(./scripts/smoke-test.sh *)",
      "Bash(scripts/archive-evidence.sh *)",
      "Bash(./scripts/archive-evidence.sh *)",
      "Bash(aws *)",
