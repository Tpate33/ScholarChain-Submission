{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scholarchain.rag.audit-record.v1",
  "title": "ScholarChain runtime audit record (README Phase 9 stage 10)",
  "description": "One audit record per question: IDs, versions, counts, hashes and tags only. No question text (only the plan hash), no retrieved text, no model output and never hidden reasoning. QuerySession and EvidenceBundle rows persist the session, the plan steps and the bundle; since RE-P9-03 the whole record is persisted as the query's QuerySession audit row (storage record named in x-persistedAs, sort key audit, create-once, auditSha256 = SHA-256 of the UTF-8 compact JSON), so x-notPersisted is empty. Refused and abstained questions are audited too. Pinned to AuditRecord by WorkflowSuite.",
  "x-persistedAs": "scholarchain.storage.query-audit.v1",
  "x-notPersisted": [],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "queryId",
    "outcome",
    "reason",
    "planSha256",
    "planVersion",
    "operations",
    "resolvedResearcherIds",
    "abstainedNames",
    "evidenceIds",
    "bundleId",
    "metricVersions",
    "graphRunId",
    "executedTemplates",
    "promptVersion",
    "outputSchemaVersion",
    "modelVersion",
    "nonProductionModel",
    "synthesisAttempts",
    "synthesisOutputSha256",
    "inputTokens",
    "outputTokens",
    "latencyMillis",
    "verification",
    "overallVerification",
    "answerSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "scholarchain.rag.audit-record.v1" },
    "queryId": { "type": "string", "pattern": "^query:[A-Za-z0-9._-]{1,128}$" },
    "outcome": { "enum": ["answered", "abstained", "refused"] },
    "reason": { "type": ["string", "null"], "description": "Abstention reason or plan refusal tag." },
    "planSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "planVersion": { "type": ["string", "null"] },
    "operations": { "type": "array", "items": { "type": "string" } },
    "resolvedResearcherIds": { "type": "array", "items": { "type": "string" } },
    "abstainedNames": { "type": "integer", "minimum": 0 },
    "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^ev:[0-9a-f]{64}$" } },
    "bundleId": { "type": ["string", "null"] },
    "metricVersions": {
      "type": "array",
      "items": { "type": "string", "description": "<record schema>|<graph policy>" }
    },
    "graphRunId": { "type": "string", "pattern": "^run:[0-9a-f]{64}$" },
    "executedTemplates": { "type": "array", "items": { "type": "string" } },
    "promptVersion": { "type": ["string", "null"] },
    "outputSchemaVersion": { "type": ["string", "null"] },
    "modelVersion": { "type": ["string", "null"] },
    "nonProductionModel": { "type": "boolean" },
    "synthesisAttempts": { "type": "integer", "minimum": 0 },
    "synthesisOutputSha256": { "type": ["string", "null"] },
    "inputTokens": { "type": ["integer", "null"] },
    "outputTokens": { "type": ["integer", "null"] },
    "latencyMillis": { "type": "integer", "minimum": 0 },
    "verification": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 },
      "propertyNames": { "enum": ["VERIFIED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONFLICTING"] }
    },
    "overallVerification": {
      "enum": ["VERIFIED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONFLICTING", null]
    },
    "answerSha256": { "type": ["string", "null"] }
  }
}
