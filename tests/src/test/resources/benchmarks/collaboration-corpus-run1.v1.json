    {
      "id": "ambiguous-name-abstains-with-all-candidates",
      "category": "graph",
      "question": "Who are the coauthors of \"{ambName}\"?",
      "expect": {
        "outcome": "abstained",
        "reason": "identity-unresolved",
        "operations": ["resolve-researcher", "direct-collaborators", "verify-claims"],
        "resolved": [],
        "candidates": ["{amb0}", "{amb1}"],
        "verifiedFacts": [],
        "allowedVerdicts": [],
        "minVerified": 0,
        "forbiddenText": [],
        "semanticIndex": null,
        "semanticTopSubject": null
      }
    },
    {
      "id": "unknown-name-abstains",
