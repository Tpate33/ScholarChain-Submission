# TEMPLATE for infra/terraform/environments/dev/env.local.conf (owner of the template: infra-engineer;
# the real file is written only by the human, in their own terminal, and is NEVER committed).
#
#   cp infra/terraform/environments/dev/env.local.conf.example infra/terraform/environments/dev/env.local.conf
#   then replace every REPLACE-ME value below and check: git check-ignore -v infra/terraform/environments/dev/env.local.conf
#
# Read (never sourced) by load_env_local_conf in scripts/lib/common.sh, after env.conf. Same format as
# env.conf: key=value, characters A-Z a-z 0-9 . _ - / : , only, every key exactly once, no defaults.
# The scripts refuse when this file is missing, tracked by git, not gitignored, or holds a REPLACE-ME
# or other dummy value (account 000000000000, 123456789012, ...; TEST-NET CIDRs 192.0.2.0/24,
# 198.51.100.0/24, 203.0.113.0/24). Nothing here is a secret, but it identifies the account and the
# human's network, so it stays out of the public repository.
config_version=scholarchain.environment-local-config.v1
environment=dev
# 12-digit AWS account ID (aws sts get-caller-identity --profile scholarchain-login, field Account).
aws_account_id=REPLACE-ME-12-digit-account-id
# The human's IAM user, verified with `aws sts get-caller-identity --profile scholarchain-login` (Arn).
admin_principal_arn=arn:aws:iam::REPLACE-ME:user/REPLACE-ME
# 1 to 4 comma-separated IPv4 CIDRs, each /24../32 (normally your public IP as /32), allowed to reach
# the API load balancer. Never 0.0.0.0/0. Example shape only: 198.51.100.7/32 (TEST-NET, refused).
api_ingress_cidrs=REPLACE-ME-your-public-ip/32
# ACM certificate ARN in the same account and Region for HTTPS listeners, or exactly `none` for HTTP
# listeners on non-default ports (8080 query, 8081 evidence); see the runtime README for the trade-off.
api_certificate_arn=REPLACE-ME-none-or-acm-certificate-arn
