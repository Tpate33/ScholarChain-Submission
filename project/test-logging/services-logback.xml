<?xml version="1.0" encoding="UTF-8"?>
<!--
  Bounded logging for the forked `services` Test JVM (owner build-engineer, BE-P10-01).
  Passed by build.sbt as -Dlogback.configurationFile. services carries logback-classic at Runtime
  (so on its Test classpath) and no logback configuration; logback without one logs everything at
  DEBUG. A modules/services/src/test/resources/logback-test.xml (service-engineer) takes
  precedence: build.sbt then omits this file. Warnings and errors only. verifyTestLogging (part
  of check) fails unless the root level here is WARN, ERROR or OFF. This file does not configure
  the services runtime or its container image.
  Deliberately not named logback*.xml, so no tool discovers it on a classpath by name.
-->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%level %logger: %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
